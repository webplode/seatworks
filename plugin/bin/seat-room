#!/usr/bin/env bash
set -eu

bin=${SEATWORKS_AGENT_BIN:-}
manifest=${SEATWORKS_KIT:-}/harness/${SEATWORKS_HARNESS:-}/harness.json

fail() {
    echo "Seat room: $1" >&2
    exit 2
}

[ -n "$bin" ] || fail "env.SEATWORKS_AGENT_BIN is unset on this seat's provider; reload the seatworks-v2 plugin."
command -v jq >/dev/null 2>&1 || fail "jq is not on PATH, so this seat's launch flags can't be read."
[ -r "$manifest" ] || fail "$manifest can't be read; set env.SEATWORKS_KIT and env.SEATWORKS_HARNESS on this seat's provider and reload the seatworks-v2 plugin."

var=$(jq -r '.configDirEnv // empty' "$manifest")
if [ -n "$var" ] && [ -z "$(printenv "$var" || true)" ]; then
    refusal="$var is unset, so this seat would run on your own settings instead of its role's. The seatworks-v2 plugin did not configure this launch: reload it, or start this agent from a provider it does not own."
    jq -e '.baseProvider == "acp" and .provider.command[1:] == $ARGS.positional' "$manifest" --args -- ${1+"$@"} >/dev/null || fail "$refusal"
    command -v node >/dev/null 2>&1 || fail "$refusal"
    exec node "$(dirname "$0")/acp-catalog.mjs" "Seat room: $refusal" "$bin" ${1+"$@"}
fi

# A seat's own config directory has no login of its own: a token kept in the owner's keychain signs it in.
secrets=$(jq -r '.provider.keychainEnv // {} | to_entries[] | .key + "\t" + .value' "$manifest")
while IFS="$(printf '\t')" read -r name service; do
    [ -n "$name" ] || continue
    [ -z "$(printenv "$name" || true)" ] || continue
    command -v security >/dev/null 2>&1 || continue
    secret=$(security find-generic-password -s "$service" -w 2>/dev/null || true)
    [ -z "$secret" ] || export "$name=$secret"
done <<SECRETS
$secrets
SECRETS

forced=$(jq -r '.provider.forceFlags // {} | to_entries[] | .key + "\t" + (.value | tostring)' "$manifest")
while IFS="$(printf '\t')" read -r flag value; do
    [ -n "$flag" ] || continue
    args=()
    drop=0
    seen=0
    for arg in ${1+"$@"}; do
        if [ "$drop" = 1 ]; then
            drop=0
            continue
        fi
        case $arg in
        "$flag")
            seen=1
            drop=1
            args+=("$flag" "$value")
            ;;
        "$flag"=*)
            seen=1
            args+=("$flag=$value")
            ;;
        *) args+=("$arg") ;;
        esac
    done
    [ "$seen" = 1 ] || args+=("$flag" "$value")
    set -- ${args[@]+"${args[@]}"}
done <<FORCED
$forced
FORCED

exec "$bin" ${1+"$@"}
