{
  "id": "claude",
  "label": "Claude Code",
  "baseProvider": "claude",
  "profileRoot": "HOME/.claude/profiles",
  "configDirEnv": "CLAUDE_CONFIG_DIR",
  "skillsDir": "skills",
  "timeline": {
    "unparsed": {
      "input": "__unparsedToolInput",
      "error": "InputValidationError[^\"]*could not be parsed as JSON"
    }
  },
  "mcp": {
    "file": ".claude.json",
    "delivery": "launch",
    "transports": [
      "stdio",
      "http",
      "sse"
    ],
    "seed": {
      "hasCompletedOnboarding": true
    },
    "clear": {
      "set": {
        "mcpServers": {},
        "enabledMcpjsonServers": []
      },
      "remove": [
        "enableAllProjectMcpServers"
      ],
      "setInEach": {
        "projects": {
          "mcpServers": {}
        }
      }
    }
  },
  "mcpCall": "^mcp__{server}__",
  "settings": {
    "file": "settings.json",
    "source": "settings.json",
    "roleSource": "settings/ROLE.settings.json",
    "inherits": {
      "from": "HOME/.claude/settings.json",
      "keys": [
        "language"
      ]
    }
  },
  "login": {
    "run": ["auth", "status"],
    "field": "loggedIn",
    "help": "Log in with claude once, outside any seat; every Claude seat shares that login, or a CLAUDE_CODE_OAUTH_TOKEN on Paseo's claude provider."
  },
  "links": [
    {
      "link": "projects",
      "target": "HOME/.claude/projects"
    }
  ],
  "provider": {
    "env": {
      "CLAUDE_CODE_DISABLE_FAST_MODE": "1",
      "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1",
      "CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT": "1",
      "SEATWORKS_HARNESS": "claude",
      "SEATWORKS_AGENT_BIN": "claude",
      "ENABLE_TOOL_SEARCH": "false",
      "ENABLE_PROMPT_CACHING_1H": "1",
      "CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD": "1",
      "CLAUDE_SECURESTORAGE_CONFIG_DIR": ""
    },
    "profileModeId": "bypassPermissions",
    "command": [
      "NODE",
      "KIT/bin/seat-room.mjs"
    ],
    "forceFlags": {
      "--setting-sources": "user",
      "--thinking-display": "summarized"
    },
    "keychainEnv": {
      "CLAUDE_CODE_OAUTH_TOKEN": "Seatworks Claude Code token"
    }
  },
  "contextFile": "CLAUDE.md",
  "projectInstructions": {
    "reads": [
      "CLAUDE.md",
      ".claude/CLAUDE.md"
    ],
    "imports": [
      "AGENTS.md",
      ".claude/AGENTS.md"
    ],
    "importAs": "@{path}"
  },
  "stateWrites": {
    "path": "settings.sandbox.filesystem.allowWrite",
    "delivery": "launch"
  },
  "projectContextOption": "additionalDirectories",
  "refuses": {
    "commands": {
      "at": "permissions.deny",
      "as": [
        "Bash({command})",
        "Bash({command} *)"
      ]
    },
    "edits": {
      "at": "permissions.deny",
      "as": [
        "Edit({path})"
      ]
    },
    "reads": {
      "at": "permissions.deny",
      "as": [
        "Read({path})"
      ]
    }
  }
}
