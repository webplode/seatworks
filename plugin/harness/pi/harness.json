{
  "id": "pi",
  "label": "Pi",
  "baseProvider": "pi",
  "profileRoot": "HOME/.pi/seats",
  "configDirEnv": "PI_CODING_AGENT_DIR",
  "contextFile": "AGENTS.md",
  "skillsDir": "skills",
  "steers": true,
  "systemPrompt": "config",
  "mcp": {
    "file": "mcp.json",
    "delivery": "file",
    "key": "mcpServers",
    "transports": [
      "stdio",
      "http"
    ],
    "desk": {
      "lifecycle": "keep-alive",
      "directTools": true
    }
  },
  "mcpServerField": "output.details.server",
  "settings": {
    "file": "settings.json",
    "source": "settings.json",
    "roleSource": "settings/ROLE.settings.json",
    "inherits": {
      "from": "HOME/.pi/agent/settings.json",
      "keys": [
        "packages"
      ]
    }
  },
  "links": [
    {
      "link": "auth.json",
      "target": "HOME/.pi/agent/auth.json"
    },
    {
      "link": "models-store.json",
      "target": "HOME/.pi/agent/models-store.json",
      "optional": true
    },
    {
      "link": "npm",
      "target": "HOME/.pi/agent/npm",
      "optional": true
    }
  ],
  "checks": [
    {
      "path": "HOME/.pi/agent/auth.json",
      "help": "Log in with pi once, outside any seat; every Pi seat shares that login."
    },
    {
      "path": "HOME/.pi/agent/npm/node_modules/pi-mcp-adapter",
      "help": "A Pi seat reaches the desk only through pi-mcp-adapter. Each Pi seat installs it on its first start, which needs the network and can take longer than Paseo waits; install it once beforehand with `pi install npm:pi-mcp-adapter` so no seat starts without its tools."
    }
  ],
  "provider": {
    "env": {
      "SEATWORKS_HARNESS": "pi",
      "SEATWORKS_AGENT_BIN": "pi"
    }
  }
}
